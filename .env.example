# ================================================
# TORÈ — Chapi-ready release/deploy kit
# Copy to `.env` and adapt for your environment.
# ================================================

# -------------------------------
# Runtime profile
# -------------------------------
# Optional helper for scripts/docs (dev | prod)
TORE_ENV=dev

# -------------------------------
# Backend (FastAPI)
# -------------------------------
# Dev (SQLite): DATABASE_URL=sqlite:///./tore.db
# Dev (Postgres): DATABASE_URL=postgresql://tore:tore@localhost:5432/tore
# Prod (Postgres managed): DATABASE_URL=postgresql://user:pass@host:5432/dbname
DATABASE_URL=postgresql://tore:tore@localhost:5432/tore

# JWT / HMAC secrets (required in prod, rotate regularly)
TORE_JWT_SECRET=change-me-jwt-secret
TORE_SECRET=change-me-generic-hmac
ORDER_QR_SECRET=change-me-order-qr-hmac
GIFT_QR_SECRET=change-me-gift-qr-hmac

# QR signing key ring for signed QR payloads.
# Format: comma-separated list, first key signs new payloads, others accepted for verify (rotation window).
# Example: TORE_QR_SIGNING_KEYS=kid2026a_superlongsecret,kid2025b_oldsecret
TORE_QR_SIGNING_KEYS=
# Optional single-key fallback (dev legacy).
TORE_QR_SIGNING_SECRET=

# CORS allowlist (CSV)
# Dev example:  http://localhost:5173,http://127.0.0.1:5173
# Prod example: https://portal.tore.example
TORE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:7357,http://127.0.0.1:7357
# Alias often used by scripts / infra docs
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:7357,http://127.0.0.1:7357

# API public base URL used for links/integrations
BASE_URL=http://localhost:8000
PUBLIC_URL=https://app.tore.be
# Portal public URL used in some deep links (polymarket service)
TORE_PORTAL_BASE_URL=http://localhost:5173

# Email OTP auth
TORE_EMAIL_OTP_DEV_MODE=true
TORE_EMAIL_OTP_DRY_RUN=0
TORE_EMAIL_OTP_EXP_MINUTES=10
TORE_EMAIL_OTP_RATE_LIMIT=3
TORE_EMAIL_OTP_WINDOW_SECONDS=60
TORE_EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_PROVIDER_API_KEY=

# Gmail SMTP: use a Google app password, never the account password.
# For real delivery, set TORE_EMAIL_OTP_DEV_MODE=false above.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tore.app.belgique@gmail.com
SMTP_FROM=TORÈ <tore.app.belgique@gmail.com>
SMTP_PASSWORD=
CONTACT_TO_EMAIL=tore.app.belgique@gmail.com

# Rate-limit defaults
TORE_RATE_LIMIT_MAX=20
TORE_RATE_LIMIT_WINDOW_S=10

# DB bootstrap: keep 1 for local SQLite convenience, 0 in Postgres/Alembic prod
TORE_AUTO_DB_BOOTSTRAP=0

# Startup DB migrations (Render/Postgres recommandé)
RUN_MIGRATIONS=1
MIGRATIONS_FATAL=1

# Privacy retention purge window (days)
TORE_PRIVACY_RETENTION_DAYS=30
RETENTION_DAYS=30

# Managed uploads. Uploads are private by default and never use the client name as a storage path.
# DEV: local non-public filesystem. PROD: set s3 with a private S3-compatible bucket.
TORE_STORAGE_BACKEND=local
TORE_UPLOAD_LOCAL_ROOT=./data/uploads
TORE_UPLOAD_MAX_BYTES=20971520
TORE_STORAGE_BUCKET=
TORE_STORAGE_S3_ENDPOINT=
TORE_STORAGE_S3_REGION=eu-west-1
# Empty disables an explicit SSE header; AES256 is the secure default in code.
TORE_STORAGE_S3_SSE=AES256
# S3 credentials use the standard AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN variables.

# Optional allowlist for global admins (for ops runbook/scripts; not enforced by core auth at this stage)
ADMIN_GLOBAL_EMAILS=admin@example.org

# Startup module toggles / feature defaults
TORE_MODULE_COMMITTEE_OS=1
TORE_MODULE_FOLKLORE_GLOSSARY=1
# Optional semantic default list for ops tooling
DEFAULT_MODULES=menu,wallet,ticker,entry,broadcast,music,battles,hunt,wifi,safety,map,polymarket_event,classement,committee_os,folklore_glossary

# Polymarket controls
POLYMARKET_GLOBAL_ENABLED=0
# Nouvelles participations avec valeur désactivées sans validation externe.
TORE_VALUE_PREDICTIONS_ENABLED=0
POLYMARKET_GLOBAL_CREATORS=

# Optional Wi-Fi credential key (if unset, backend logs dev obfuscation fallback)
WIFI_CRED_KEY=change-me-wifi-cred-key

# -------------------------------
# Portal (Vite / React)
# -------------------------------
# Preferred variable in codebase:
VITE_API_BASE_URL=http://localhost:8000
# Legacy fallback still read by some pages:
VITE_API_BASE=http://localhost:8000

# -------------------------------
# Flutter app
# -------------------------------
TORE_API_BASE_URL=http://localhost:8000
# Optional deep-link scheme docs reference
TORE_DEEP_LINK_SCHEME=tore
