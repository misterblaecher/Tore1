# Gmail dédié aux emails TORÈ. Charger ces variables dans le serveur backend.
# SMTP_PASSWORD doit contenir un mot de passe d'application Google,
# jamais le mot de passe principal du compte. Ne pas enregistrer le secret ici.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tore.app.belgique@gmail.com
SMTP_FROM=TORÈ <tore.app.belgique@gmail.com>
SMTP_PASSWORD=
CONTACT_TO_EMAIL=tore.app.belgique@gmail.com
TORE_EMAIL_OTP_DEV_MODE=false
TORE_EMAIL_OTP_DRY_RUN=0
ALLOW_DEV_OTP=false
MAIL_OVERRIDE_TO=
